# ---------------------------------------------------------------------------
# K Cars for Rent — environment variables
# Copy to .env.local for local dev. In production set these in
# Netlify → Site configuration → Environment variables.
# ---------------------------------------------------------------------------

# --- Email (Resend) --------------------------------------------------------
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The "from" address. The domain must be verified in Resend first.
# Until kcarsforrent.com is verified you can use onboarding@resend.dev for testing.
BOOKING_FROM_EMAIL="K Cars for Rent <bookings@kcarsforrent.com>"

# Where new booking requests are sent. Comma-separate for multiple recipients.
OWNER_NOTIFICATION_EMAIL=owner@kcarsforrent.com

# Optional: replies from customers go here instead of the from address.
BOOKING_REPLY_TO=hello@kcarsforrent.com

# --- Admin dashboard -------------------------------------------------------
# Password for /admin. Use something long and random.
ADMIN_PASSWORD=change-me-to-a-long-random-passphrase

# Secret used to sign the admin session cookie.
# Generate with:  openssl rand -base64 32
ADMIN_SESSION_SECRET=change-me-openssl-rand-base64-32

# --- Site ------------------------------------------------------------------
# Public base URL, used for absolute links inside emails.
NEXT_PUBLIC_SITE_URL=https://kcarsforrent.com
